SERPAPI_KEY=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Localizacao usada pelo Google Shopping para precos e disponibilidade regionais.
GOOGLE_LOCATION=Sao Paulo, State of Sao Paulo, Brazil

# Controles conservadores para evitar rajadas de requisicoes.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
REQUEST_DELAY_SECONDS=1.0
RESULT_LIMIT=5
