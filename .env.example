# ---------------------------------------------------------------- navegador
# true executa sem abrir a janela; false exibe o Chromium.
RPA_HEADLESS=true

# Deixe vazio para usar o Chromium do Playwright. Valores opcionais: chrome ou msedge.
RPA_BROWSER_CHANNEL=

RPA_BROWSER_TIMEOUT_SECONDS=45
RPA_SLOW_MO_MS=0

# Intervalo entre pesquisas para reduzir carga nos sites.
REQUEST_DELAY_SECONDS=2.0
RESULT_LIMIT=5

# ----------------------------------------------------------------- postgres
# No Railway, vincule um plugin PostgreSQL ao servico: a variavel DATABASE_URL
# e injetada automaticamente e as tabelas sao criadas na subida da aplicacao.
# Localmente, aponte para o seu banco:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copercitrus

# ---------------------------------------------------------------------- api
# Porta HTTP. O Railway define PORT automaticamente; nao precisa alterar la.
PORT=8000

# Se preenchida, os endpoints que disparam coletas (POST /buscas e
# POST /buscas/planilha) passam a exigir o header X-API-Key com este valor.
# Deixe vazio somente em ambiente privado.
API_KEY=
